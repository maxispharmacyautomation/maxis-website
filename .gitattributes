# Handle line endings automatically for files detected as text
# and perform LF normalization (standard for Web/Vercel)
* text=auto eol=lf

# Explicitly enforce LF for web-related text files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.mjs text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
